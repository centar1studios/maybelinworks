{
    "name": "maybelinworks",
    "compatibility_date": "2026-08-12",
    "main": "./src/worker.js",

    "observability": {
        "enabled": false
    },

    "assets": {
        "directory": "./public",
        "binding": "ASSETS",
        "run_worker_first": [
            "/",
            "/api/*",
            "/admin/*",
            "/media/*"
        ]
    },

    "d1_databases": [
        {
            "binding": "DB",
            "database_name": "maybelinworks-db",
            "database_id": "cfc698b0-c7ad-4ee6-91e9-d9157baf1d47"
        }
    ],

    "r2_buckets": [
        {
            "binding": "MEDIA",
            "bucket_name": "maybelinworks-media"
        }
    ]
}
