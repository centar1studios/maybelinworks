{
    "name": "maybelinworks",
    "compatibility_date": "2026-08-12",

    "observability": {
        "enabled": false
    },

    "main": "./src/worker.js",

    "assets": {
        "directory": "./public",
        "binding": "ASSETS",
        "run_worker_first": [
            "/api/*",
            "/admin/*"
        ]
    }
}
